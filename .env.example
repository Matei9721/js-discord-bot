BOT_TOKEN=
CLIENT_ID=
# Set for immediate guild slash-command registration; omit for global commands.
GUILD_ID=
NODE_ENV=production
LOG_LEVEL=info
# Optional chatbot: responds to "anime slave", @mentions, and replies to the bot.
DEEPSEEK_API_KEY=
# Current fast chat model; thinking is disabled for quicker replies.
# DEEPSEEK_MODEL=deepseek-flash
# REGISTER_COMMANDS=false
# Optional Netscape-format cookies file; only needed when YouTube requires it.
# YOUTUBE_COOKIES_FILE=/run/secrets/youtube-cookies
# Optional executable overrides for local installs:
# YTDLP_PATH=
# FFMPEG_PATH=
# Quality is the default. Set true to opt into the faster, lower-quality source.
# YOUTUBE_FAST_START=false
